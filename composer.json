{
    "name": "readydata/magento-modules",
    "description": "ReadyData modules for Magento 2 compatibility",
    "type": "magento2-module",
    "license": "proprietary",
    "version": "0.1.0",
    "replace": {
        "readydata/module-import": "self.version"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0",
        "guzzlehttp/guzzle": "^7.5",
        "magento/framework": ">=103.0.0",
        "magento/module-catalog": ">=104.0.0",
        "magento/module-configurable-product": ">=100.4.0",
        "magento/module-eav": ">=102.0.0",
        "magento/module-store": ">=101.0.0"
    },
    "suggest": {
        "magento/module-inventory-api": "Multi Source Inventory (MSI) stock updates",
        "magento/module-product-video": "External video entries in the product media gallery",
        "magento/module-swatches": "The swatch_image media role"
    },
    "autoload": {
        "files": [
            "Import/registration.php"
        ],
        "psr-4": {
            "ReadyData\\Import\\": "Import/"
        }
    }
}
