<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <readydata_import>
            <general>
                <enabled>1</enabled>
                <batch_size>500</batch_size>
                <continue_on_error>1</continue_on_error>
            </general>
            <behavior>
                <create_missing_options>1</create_missing_options>
                <url_rewrite_conflict>append</url_rewrite_conflict>
            </behavior>
            <attributes>
                <auto_create>1</auto_create>
            </attributes>
            <categories>
                <enabled>0</enabled>
                <allow_move>0</allow_move>
                <allow_delete>0</allow_delete>
                <allow_cross_root_move>0</allow_cross_root_move>
                <replace_scope>all_roots</replace_scope>
            </categories>
            <media>
                <enabled>1</enabled>
                <download_timeout>15</download_timeout>
                <download_concurrency>4</download_concurrency>
                <max_file_size_kb>10240</max_file_size_kb>
                <allowed_extensions>jpg,jpeg,png,gif,webp</allowed_extensions>
                <allowed_hosts/>
                <redownload_existing>0</redownload_existing>
                <auto_assign_roles>1</auto_assign_roles>
            </media>
            <indexing>
                <mode>partial</mode>
                <clean_cache>1</clean_cache>
            </indexing>
            <logging>
                <enabled>1</enabled>
            </logging>
            <events>
                <dispatch_product_events>1</dispatch_product_events>
                <dispatch_save_after>1</dispatch_save_after>
                <hydrate_media>1</hydrate_media>
            </events>
        </readydata_import>
    </default>
</config>
