<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Service contracts -->
    <preference for="ReadyData\Import\Api\ProductImportInterface"
                type="ReadyData\Import\Model\ProductImport"/>
    <preference for="ReadyData\Import\Api\Data\ProductInterface"
                type="ReadyData\Import\Model\Data\Product"/>
    <preference for="ReadyData\Import\Api\Data\CustomAttributeInterface"
                type="ReadyData\Import\Model\Data\CustomAttribute"/>
    <preference for="ReadyData\Import\Api\Data\ProductStoreValuesInterface"
                type="ReadyData\Import\Model\Data\ProductStoreValues"/>
    <preference for="ReadyData\Import\Api\Data\StockDataInterface"
                type="ReadyData\Import\Model\Data\StockData"/>
    <preference for="ReadyData\Import\Api\Data\ConfigurableDataInterface"
                type="ReadyData\Import\Model\Data\ConfigurableData"/>
    <preference for="ReadyData\Import\Api\Data\ProductLinksInterface"
                type="ReadyData\Import\Model\Data\ProductLinks"/>
    <preference for="ReadyData\Import\Api\Data\MediaEntryInterface"
                type="ReadyData\Import\Model\Data\MediaEntry"/>
    <preference for="ReadyData\Import\Api\Data\TierPriceInterface"
                type="ReadyData\Import\Model\Data\TierPrice"/>
    <preference for="ReadyData\Import\Api\Data\ImportSettingsInterface"
                type="ReadyData\Import\Model\Data\ImportSettings"/>
    <preference for="ReadyData\Import\Api\Data\ImportResultInterface"
                type="ReadyData\Import\Model\Data\ImportResult"/>
    <preference for="ReadyData\Import\Api\Data\StoreResultInterface"
                type="ReadyData\Import\Model\Data\StoreResult"/>
    <preference for="ReadyData\Import\Api\Data\ImportResponseInterface"
                type="ReadyData\Import\Model\Data\ImportResponse"/>

    <!-- Attribute definition sync -->
    <preference for="ReadyData\Import\Api\AttributeSyncInterface"
                type="ReadyData\Import\Model\AttributeSync"/>
    <preference for="ReadyData\Import\Api\Data\AttributeDefinitionInterface"
                type="ReadyData\Import\Model\Data\AttributeDefinition"/>
    <preference for="ReadyData\Import\Api\Data\AttributeSetPlacementInterface"
                type="ReadyData\Import\Model\Data\AttributeSetPlacement"/>
    <preference for="ReadyData\Import\Api\Data\AmastyAttributeSettingsInterface"
                type="ReadyData\Import\Model\Data\AmastyAttributeSettings"/>
    <preference for="ReadyData\Import\Api\Data\AmastyOptionSettingInterface"
                type="ReadyData\Import\Model\Data\AmastyOptionSetting"/>
    <preference for="ReadyData\Import\Api\Data\AttributeSyncResultInterface"
                type="ReadyData\Import\Model\Data\AttributeSyncResult"/>
    <preference for="ReadyData\Import\Api\Data\AttributeSyncResponseInterface"
                type="ReadyData\Import\Model\Data\AttributeSyncResponse"/>

    <!-- Category sync -->
    <preference for="ReadyData\Import\Api\CategorySyncInterface"
                type="ReadyData\Import\Model\CategorySync"/>
    <preference for="ReadyData\Import\Api\Data\CategoryDefinitionInterface"
                type="ReadyData\Import\Model\Data\CategoryDefinition"/>
    <preference for="ReadyData\Import\Api\Data\CategoryStoreValuesInterface"
                type="ReadyData\Import\Model\Data\CategoryStoreValues"/>
    <preference for="ReadyData\Import\Api\Data\CategoryStoreResultInterface"
                type="ReadyData\Import\Model\Data\CategoryStoreResult"/>
    <preference for="ReadyData\Import\Api\Data\CategorySyncResultInterface"
                type="ReadyData\Import\Model\Data\CategorySyncResult"/>
    <preference for="ReadyData\Import\Api\Data\CategorySyncResponseInterface"
                type="ReadyData\Import\Model\Data\CategorySyncResponse"/>

    <!--
        Image downloads. Per-request options (sink, timeouts, redirect cap) are
        set by PooledDownloader; the client itself only carries what must be
        fixed for every request. Kept as a dedicated virtual type so module
        traffic can never inherit another module's client configuration.
    -->
    <virtualType name="ReadyData\Import\Model\Media\GuzzleClient" type="GuzzleHttp\Client">
        <arguments>
            <argument name="config" xsi:type="array">
                <item name="http_errors" xsi:type="boolean">false</item>
                <item name="verify" xsi:type="boolean">true</item>
            </argument>
        </arguments>
    </virtualType>
    <preference for="ReadyData\Import\Model\Media\DownloaderInterface"
                type="ReadyData\Import\Model\Media\PooledDownloader"/>
    <type name="ReadyData\Import\Model\Media\PooledDownloader">
        <arguments>
            <argument name="httpClient" xsi:type="object">ReadyData\Import\Model\Media\GuzzleClient</argument>
        </arguments>
    </type>

    <!--
        "Is this media file still referenced?", for consumers of
        readydata_import_product_media_changed acting on removed_files.

        The role list is what makes the check complete for a given store: a custom
        image role attribute holding a path is a reference, and appending its code
        here is how the check learns about it. Removing one narrows the check and
        makes false "unreferenced" answers more likely.

        It defaults to the same four codes as MediaProcessor::ROLE_CODES but is a
        separate list on purpose: that one is "roles the importer writes", this one
        is "roles that count as a reference", and a store's own role attribute
        belongs in the second without belonging in the first.
    -->
    <preference for="ReadyData\Import\Api\MediaReferenceCheckerInterface"
                type="ReadyData\Import\Model\Media\MediaReferenceChecker"/>
    <type name="ReadyData\Import\Model\Media\MediaReferenceChecker">
        <arguments>
            <argument name="roleAttributeCodes" xsi:type="array">
                <item name="image" xsi:type="string">image</item>
                <item name="small_image" xsi:type="string">small_image</item>
                <item name="thumbnail" xsi:type="string">thumbnail</item>
                <item name="swatch_image" xsi:type="string">swatch_image</item>
            </argument>
        </arguments>
    </type>

    <!--
        The read-only orphan-media report (PLAN.md §9.1). Same four role codes as
        MediaReferenceChecker above — the two lists answer the same question and
        must stay in step; a single shared value object would be the cleaner fix
        if phase two ever ships.
    -->
    <type name="ReadyData\Import\Model\ResourceModel\MediaOrphanScan">
        <arguments>
            <argument name="roleAttributeCodes" xsi:type="array">
                <item name="image" xsi:type="string">image</item>
                <item name="small_image" xsi:type="string">small_image</item>
                <item name="thumbnail" xsi:type="string">thumbnail</item>
                <item name="swatch_image" xsi:type="string">swatch_image</item>
            </argument>
        </arguments>
    </type>

    <!-- CLI -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="readydata_import_media_report_orphans" xsi:type="object">
                    ReadyData\Import\Console\ReportOrphanMediaCommand
                </item>
            </argument>
        </arguments>
    </type>

    <!-- Dedicated log file: var/log/readydata_import.log -->
    <type name="ReadyData\Import\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">readydata_import</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">ReadyData\Import\Logger\Handler</item>
            </argument>
        </arguments>
    </type>

    <!--
        The import pipeline. Order is controlled by each processor's
        getSortOrder(); add third-party steps by appending items here.
    -->
    <type name="ReadyData\Import\Model\ImportService">
        <arguments>
            <argument name="processors" xsi:type="array">
                <item name="attributes" xsi:type="object">ReadyData\Import\Model\Processor\AttributeProcessor</item>
                <item name="entity" xsi:type="object">ReadyData\Import\Model\Processor\EntityProcessor</item>
                <item name="eav_values" xsi:type="object">ReadyData\Import\Model\Processor\EavValueProcessor</item>
                <item name="websites" xsi:type="object">ReadyData\Import\Model\Processor\WebsiteProcessor</item>
                <item name="stock" xsi:type="object">ReadyData\Import\Model\Processor\StockProcessor</item>
                <item name="url_rewrites" xsi:type="object">ReadyData\Import\Model\Processor\UrlRewriteProcessor</item>
                <item name="category_links" xsi:type="object">ReadyData\Import\Model\Processor\CategoryLinkProcessor</item>
                <item name="links" xsi:type="object">ReadyData\Import\Model\Processor\LinkProcessor</item>
                <item name="configurables" xsi:type="object">ReadyData\Import\Model\Processor\ConfigurableProcessor</item>
                <item name="media" xsi:type="object">ReadyData\Import\Model\Processor\MediaProcessor</item>
                <item name="tier_prices" xsi:type="object">ReadyData\Import\Model\Processor\TierPriceProcessor</item>
            </argument>
        </arguments>
    </type>

    <!--
        Event dispatch is configured under Stores > Configuration > ReadyData >
        Product Import > Events. When the "Also Dispatch catalog_product_save_after"
        setting is on, the native URL-rewrite/inventory observers are suppressed
        for the duration of the import (see the plugins below) so they never
        double-write.
    -->

    <!-- Import-active flag consulted by the observer-suppression plugins; must be shared -->
    <type name="ReadyData\Import\Model\ImportState" shared="true"/>

    <type name="Magento\CatalogUrlRewrite\Observer\ProductProcessUrlRewriteSavingObserver">
        <plugin name="readydata_suppress_url_rewrite_during_import"
                type="ReadyData\Import\Plugin\CatalogUrlRewrite\SuppressUrlRewriteDuringImport"/>
    </type>
    <type name="Magento\CatalogInventory\Observer\SaveInventoryDataObserver">
        <plugin name="readydata_suppress_inventory_save_during_import"
                type="ReadyData\Import\Plugin\CatalogInventory\SuppressInventorySaveDuringImport"/>
    </type>

    <!-- Request-scoped caches must be shared instances (default), listed here for clarity -->
    <type name="ReadyData\Import\Model\Cache\AttributeMetadataCache" shared="true"/>
    <type name="ReadyData\Import\Model\Cache\StoreWebsiteMap" shared="true"/>
    <type name="ReadyData\Import\Model\Cache\CategoryPathResolver" shared="true"/>
    <!--
        Shared is load-bearing here, not just an optimization: the category
        endpoint invalidates this memo whenever it creates, renames, promotes or
        removes a root, and a second instance would keep serving the stale map to
        whichever consumer held it.
    -->
    <type name="ReadyData\Import\Model\Cache\RootCategoryRegistry" shared="true"/>
    <type name="ReadyData\Import\Model\Cache\CustomerGroupMap" shared="true"/>
    <type name="ReadyData\Import\Model\ResourceModel\AttributeOption" shared="true"/>
    <type name="ReadyData\Import\Model\ResourceModel\AmastyAttribute" shared="true"/>
    <type name="ReadyData\Import\Model\ResourceModel\Category" shared="true"/>
    <!--
        Memoizes the required-attribute probe for the request. Shared matters
        beyond that: CategoryPathResolver creates through this writer, so both
        category-creating paths run the same defaults and store emulation.
    -->
    <type name="ReadyData\Import\Model\Category\CategoryWriter" shared="true"/>
    <type name="ReadyData\Import\Model\ResourceModel\AttributeDefinition" shared="true"/>
    <type name="ReadyData\Import\Model\ResourceModel\ProductLink" shared="true"/>
    <!-- Memoizes the link field and the ProductVideo table probe for the request -->
    <type name="ReadyData\Import\Model\ResourceModel\ProductMediaGallery" shared="true"/>
    <type name="ReadyData\Import\Model\ResourceModel\TierPrice" shared="true"/>
</config>
